{
  "name": "stackr",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test:api": "esbuild server/test/api.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/stackr/api.test.mjs --log-level=warning && node node_modules/.cache/stackr/api.test.mjs",
    "dev:api": "esbuild server/dev.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/stackr/dev.mjs --log-level=warning && node node_modules/.cache/stackr/dev.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.9",
    "vite": "^8.3.5"
  }
}
